# Environment Variables for Pune Transit MCP Server

# SQLite Database Location
DB_PATH=./data/pune_transit.db

# Pune Metro Curated Dataset Path
METRO_DATA_PATH=./data/metro.json

# Pune Curated Landmarks Dataset Path
PLACES_DATA_PATH=./data/pune_places.json

# Geocoder Configuration (OpenStreetMap Nominatim by default)
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_API_KEY=
USER_AGENT=PuneTransitMCP/1.0 (transit-assistant@pune)

# Remote Streamable HTTP Server Configuration
PORT=8000
MCP_TOKENS=local:demo-token-123,user1:secret-token-pune

# Logging Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Maximum data age before DATA_STALE warnings
DATA_MAX_AGE_DAYS=90

# Optional Google Maps API Key (Leaflet & OSM Live Engine used as zero-error fallback)
GOOGLE_MAPS_API_KEY=
